[Unit]
Description=QFw telemetry: OpenTelemetry Collector (OTLP in, the stores out)
Documentation=file:@PREFIX@/etc/otel-collector.yaml
After=network-online.target qfw-telemetry-tempo.service qfw-telemetry-loki.service
Wants=network-online.target qfw-telemetry-tempo.service qfw-telemetry-loki.service

[Service]
@USER_LINE@
ExecStart=@PREFIX@/bin/otelcol-contrib --config=@PREFIX@/etc/otel-collector.yaml
WorkingDirectory=@PREFIX@
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=@WANTED_BY@
